{
  "name": "portal-frontend",
  "private": true,
  "scripts": {
    "build:catalogo": "esbuild index.jsx --bundle --minify --format=iife --loader:.html=text --outfile=dist/bundle.js",
    "build:organizacoes": "esbuild organizacoes.jsx --bundle --minify --format=iife --loader:.html=text --outfile=dist/organizacoes-bundle.js",
    "copy:html": "node -e \"const fs=require('fs');fs.copyFileSync('index.html','dist/index.html');fs.copyFileSync('organizacoes.html','dist/organizacoes.html');fs.copyFileSync('banco.json','dist/banco.json');fs.copyFileSync('banco-detalhes.json','dist/banco-detalhes.json')\"",
    "build": "npm run build:catalogo && npm run build:organizacoes && npm run copy:html",
    "dev": "npm run build && npx serve dist"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  }
}
